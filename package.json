{
  "name": "json-safe",
  "version": "0.1.0",
  "description": "JSON.stringify that never throws: handles circular references, BigInt, Map, Set, Error (with cause), typed arrays, throwing getters and more. Optional sorted keys and depth limit. Zero dependencies.",
  "keywords": [
    "json",
    "stringify",
    "safe",
    "circular",
    "bigint",
    "map",
    "set",
    "error",
    "serialize",
    "logging",
    "fast-safe-stringify"
  ],
  "homepage": "https://github.com/acus9345/json-safe#readme",
  "bugs": {
    "url": "https://github.com/acus9345/json-safe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acus9345/json-safe.git"
  },
  "license": "MIT",
  "author": "acus9345 <acus9345@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prelint": "npm run build",
    "lint": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
